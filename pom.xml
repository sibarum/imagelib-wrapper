<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>sibarum.imagelib</groupId>
    <artifactId>imagelib-wrapper-parent</artifactId>
    <version>0.1.2-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>imagelib-wrapper-parent</name>
    <description>
        Image decoding through Rust, as modules: imagelib-wrapper (the Java API, holding no platform knowledge), and
        one imagelib-wrapper-&lt;os&gt; module per operating system with that OS's build of the imagelib library. The
        crate's source is shared, in native/; each OS module builds it with its own native/build.sh.
    </description>

    <modules>
        <!-- Where an OS module's library is, as an interface the facade and the OS modules share. -->
        <module>imagelib-wrapper-api</module>
        <!-- The OS halves: each bundles only its own platform's library. imagelib-wrapper's profiles add one. -->
        <module>imagelib-wrapper-windows</module>
        <module>imagelib-wrapper-linux</module>
        <!-- The library vexelray-codec and vexelray-gui depend on, under the artifactId they already name. -->
        <module>imagelib-wrapper</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>sibarum.imagelib</groupId>
                <artifactId>imagelib-wrapper-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.imagelib</groupId>
                <artifactId>imagelib-wrapper-windows</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.imagelib</groupId>
                <artifactId>imagelib-wrapper-linux</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Stamps every module with the exact source of its binaries (the commit, plus a digest of any
                 uncommitted change), so whatever is built on it knows what it was built from. See
                 vexelray-build/README.md. -->
            <plugin>
                <groupId>dev.vexelray.build</groupId>
                <artifactId>vexelray-build-maven-plugin</artifactId>
                <version>0.1.2-SNAPSHOT</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>identify</goal>
                            <goal>isolate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
